+    private void CreateResizeGrips()
+    {
+        AddResizeGrip(ResizeDirection.Top, Cursors.SizeNS);
+        AddResizeGrip(ResizeDirection.Bottom, Cursors.SizeNS);
+        AddResizeGrip(ResizeDirection.Left, Cursors.SizeWE);
+        AddResizeGrip(ResizeDirection.Right, Cursors.SizeWE);
+        AddResizeGrip(ResizeDirection.TopLeft, Cursors.SizeNWSE);
+        AddResizeGrip(ResizeDirection.TopRight, Cursors.SizeNESW);
+        AddResizeGrip(ResizeDirection.BottomLeft, Cursors.SizeNESW);
+        AddResizeGrip(ResizeDirection.BottomRight, Cursors.SizeNWSE);
+        LayoutResizeGrips();
+    }
+
+    private void AddResizeGrip(ResizeDirection direction, Cursor cursor)
+    {
+        var grip = new Panel
+        {
+            BackColor = Color.Transparent,
+            Cursor = cursor,
+            TabStop = false,
+            Tag = direction
+        };
+        grip.MouseDown += OnResizeGripMouseDown;
+        grip.MouseMove += OnResizeGripMouseMove;
+        grip.MouseUp += OnResizeGripMouseUp;
+        resizeGrips.Add(grip);
+        Controls.Add(grip);
+        grip.BringToFront();
+    }
+
+    private void LayoutResizeGrips()
+    {
+        if (resizeGrips.Count != 8)
+            return;
+
+        var active = WindowState == FormWindowState.Normal && !shutdownStarted;
+        foreach (var grip in resizeGrips)
+            grip.Visible = active;
+        if (!active)
+            return;
+
+        var width = ClientSize.Width;
+        var height = ClientSize.Height;
+        var edge = ResizeGripThickness;
+        var corner = ResizeCornerSize;
+        var horizontal = Math.Max(0, width - (corner * 2));
+        var vertical = Math.Max(0, height - (corner * 2));
+
+        SetResizeGripBounds(ResizeDirection.Top, corner, 0, horizontal, edge);
+        SetResizeGripBounds(ResizeDirection.Bottom, corner, Math.Max(0, height - edge), horizontal, edge);
+        SetResizeGripBounds(ResizeDirection.Left, 0, corner, edge, vertical);
+        SetResizeGripBounds(ResizeDirection.Right, Math.Max(0, width - edge), corner, edge, vertical);
+        SetResizeGripBounds(ResizeDirection.TopLeft, 0, 0, corner, corner);
+        SetResizeGripBounds(ResizeDirection.TopRight, Math.Max(0, width - corner), 0, corner, corner);
+        SetResizeGripBounds(ResizeDirection.BottomLeft, 0, Math.Max(0, height - corner), corner, corner);
+        SetResizeGripBounds(ResizeDirection.BottomRight, Math.Max(0, width - corner), Math.Max(0, height - corner), corner, corner);
+
+        foreach (var grip in resizeGrips)
+            grip.BringToFront();
+    }
+
+    private void SetResizeGripBounds(ResizeDirection direction, int x, int y, int width, int height)
+    {
+        var grip = resizeGrips.First(c => c.Tag is ResizeDirection d && d == direction);
+        grip.SetBounds(x, y, Math.Max(1, width), Math.Max(1, height));
+    }
+
+    private void OnResizeGripMouseDown(object? sender, MouseEventArgs e)
+    {
+        if (e.Button != MouseButtons.Left || WindowState != FormWindowState.Normal || sender is not Control grip || grip.Tag is not ResizeDirection direction)
+            return;
+
+        manualResizeActive = true;
+        manualResizeDirection = direction;
+        manualResizeStartCursor = Cursor.Position;
+        manualResizeStartBounds = Bounds;
+        grip.Capture = true;
+    }
+
+    private void OnResizeGripMouseMove(object? sender, MouseEventArgs e)
+    {
+        if (!manualResizeActive || (Control.MouseButtons & MouseButtons.Left) == 0)
+            return;
+        ApplyManualResize(Cursor.Position);
+    }
+
+    private void OnResizeGripMouseUp(object? sender, MouseEventArgs e)
+    {
+        if (e.Button == MouseButtons.Left)
+            EndManualResize();
+    }
+
+    private void ApplyManualResize(Point cursorPosition)
+    {
+        var dx = cursorPosition.X - manualResizeStartCursor.X;
+        var dy = cursorPosition.Y - manualResizeStartCursor.Y;
+        var start = manualResizeStartBounds;
+        var left = start.Left;
+        var top = start.Top;
+        var width = start.Width;
+        var height = start.Height;
+
+        var resizeLeft = manualResizeDirection is ResizeDirection.Left or ResizeDirection.TopLeft or ResizeDirection.BottomLeft;
+        var resizeRight = manualResizeDirection is ResizeDirection.Right or ResizeDirection.TopRight or ResizeDirection.BottomRight;
+        var resizeTop = manualResizeDirection is ResizeDirection.Top or ResizeDirection.TopLeft or ResizeDirection.TopRight;
+        var resizeBottom = manualResizeDirection is ResizeDirection.Bottom or ResizeDirection.BottomLeft or ResizeDirection.BottomRight;
+
+        if (resizeLeft)
+        {
+            left = start.Left + dx;
+            width = start.Width - dx;
+        }
+        else if (resizeRight)
+        {
+            width = start.Width + dx;
+        }
+
+        if (resizeTop)
+        {
+            top = start.Top + dy;
+            height = start.Height - dy;
+        }
+        else if (resizeBottom)
+        {
+            height = start.Height + dy;
+        }
+
+        var minWidth = Math.Max(1, MinimumSize.Width);
+        var minHeight = Math.Max(1, MinimumSize.Height);
+        if (width < minWidth)
+        {
+            width = minWidth;
+            if (resizeLeft)
+                left = start.Right - minWidth;
+        }
+        if (height < minHeight)
+        {
+            height = minHeight;
+            if (resizeTop)
+                top = start.Bottom - minHeight;
+        }
+
+        SetBounds(left, top, width, height);
+    }
+
+    private void EndManualResize()
+    {
+        if (!manualResizeActive)
+            return;
+        manualResizeActive = false;
+        Capture = false;
+        foreach (var grip in resizeGrips)
+            grip.Capture = false;
+    }
